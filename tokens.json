{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Wise Design — canonical design tokens. Single source of truth. Audited from docs.wise.design (June 2026). W3C Design Tokens Format (2025.10). Layered primitive -> semantic -> component. Target platform: Web. NOTE: Wise publishes light-mode hex only; dark-mode values and numeric type scale are NOT published by Wise and are marked $extensions.wise.derived=true where supplied.",
  "$extensions": {
    "wise.meta": {
      "name": "Wise Design",
      "version": "1.0",
      "author": "Noah DiJulio",
      "adminEmail": "ndijulio@gmail.com",
      "sampleText": "One account, all kinds of money",
      "source": "https://docs.wise.design/foundations",
      "auditedOn": "2026-06-04",
      "platform": "web",
      "structureModel": "Material Design (primitive/semantic/component)",
      "namingRules": "category.role.variant.state — name by intent not appearance (e.g. color.sentiment.negative not color.red). Primitive tokens are raw values; semantic tokens alias primitives and carry meaning; component tokens alias semantics. Never hard-code; never reference primitives directly in product."
    }
  },

  "primitive": {
    "$description": "Raw values. Never use directly in product — reference via semantic tokens.",
    "color": {
      "core": {
        "bright-green":  { "$type": "color", "$value": "#9FE870", "$description": "Primary brand colour. PANTONE 7487." },
        "forest-green":  { "$type": "color", "$value": "#163300", "$description": "Primary brand dark. PANTONE 2411." }
      },
      "secondary": {
        "bright-orange": { "$type": "color", "$value": "#FFC091" },
        "bright-yellow": { "$type": "color", "$value": "#FFEB69" },
        "bright-blue":   { "$type": "color", "$value": "#A0E1E1" },
        "bright-pink":   { "$type": "color", "$value": "#FFD7EF" },
        "dark-purple":   { "$type": "color", "$value": "#260A2F" },
        "dark-gold":     { "$type": "color", "$value": "#3A341C" },
        "dark-charcoal": { "$type": "color", "$value": "#21231D" },
        "dark-maroon":   { "$type": "color", "$value": "#320707" }
      },
      "neutral": {
        "white":    { "$type": "color", "$value": "#FFFFFF" },
        "ink-900":  { "$type": "color", "$value": "#0E0F0C", "$description": "Content primary." },
        "ink-800":  { "$type": "color", "$value": "#121511", "$description": "Base dark." },
        "ink-600":  { "$type": "color", "$value": "#454745", "$description": "Content secondary." },
        "ink-500":  { "$type": "color", "$value": "#6A6C6A", "$description": "Content tertiary." },
        "ink-400":  { "$type": "color", "$value": "#868685", "$description": "Interactive secondary." }
      },
      "alpha": {
        "forest-08": { "$type": "color", "$value": "#16330014", "$description": "Forest green @ 8% — neutral/overlay surfaces." },
        "ink-12":    { "$type": "color", "$value": "#0E0F0C1F", "$description": "Ink @ 12% — borders." }
      },
      "sentiment": {
        "negative": { "$type": "color", "$value": "#A8200D" },
        "positive": { "$type": "color", "$value": "#2F5711" },
        "warning":  { "$type": "color", "$value": "#EDC843", "$description": "Background only — not accessible as text." }
      }
    },

    "dimension": {
      "$description": "Base spacing/size scale (4px base unit).",
      "size-0":   { "$type": "dimension", "$value": "0px" },
      "size-4":   { "$type": "dimension", "$value": "4px" },
      "size-8":   { "$type": "dimension", "$value": "8px" },
      "size-12":  { "$type": "dimension", "$value": "12px" },
      "size-16":  { "$type": "dimension", "$value": "16px" },
      "size-24":  { "$type": "dimension", "$value": "24px" },
      "size-32":  { "$type": "dimension", "$value": "32px" },
      "size-40":  { "$type": "dimension", "$value": "40px" },
      "size-48":  { "$type": "dimension", "$value": "48px" },
      "size-56":  { "$type": "dimension", "$value": "56px" },
      "size-64":  { "$type": "dimension", "$value": "64px" },
      "size-72":  { "$type": "dimension", "$value": "72px" },
      "size-80":  { "$type": "dimension", "$value": "80px" },
      "size-88":  { "$type": "dimension", "$value": "88px" },
      "size-96":  { "$type": "dimension", "$value": "96px" },
      "size-104": { "$type": "dimension", "$value": "104px" },
      "size-112": { "$type": "dimension", "$value": "112px" },
      "size-120": { "$type": "dimension", "$value": "120px" },
      "size-128": { "$type": "dimension", "$value": "128px" }
    },

    "radius": {
      "$description": "Two scales: desktop and mobile.",
      "desktop": {
        "small":   { "$type": "dimension", "$value": "16px" },
        "medium":  { "$type": "dimension", "$value": "20px" },
        "large":   { "$type": "dimension", "$value": "30px" },
        "x-large": { "$type": "dimension", "$value": "40px" },
        "2x-large":{ "$type": "dimension", "$value": "60px" }
      },
      "mobile": {
        "small":   { "$type": "dimension", "$value": "10px" },
        "medium":  { "$type": "dimension", "$value": "16px" },
        "large":   { "$type": "dimension", "$value": "24px" },
        "x-large": { "$type": "dimension", "$value": "32px" },
        "2x-large":{ "$type": "dimension", "$value": "48px" }
      }
    },

    "fontFamily": {
      "inter":     { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Default product typeface." },
      "wise-sans": { "$type": "fontFamily", "$value": ["Wise Sans", "Inter", "sans-serif"], "$description": "Display typeface — short, celebratory headlines only." }
    },
    "fontWeight": {
      "medium":    { "$type": "fontWeight", "$value": 500 },
      "semi-bold": { "$type": "fontWeight", "$value": 600 }
    }
  },

  "semantic": {
    "$description": "Intent-based tokens that alias primitives. Use these in product.",

    "color": {
      "light": {
        "$description": "Light theme — values audited directly from docs.wise.design/foundations/colour.",
        "content": {
          "primary":   { "$type": "color", "$value": "{primitive.color.neutral.ink-900}", "$description": "Emphasised primary content." },
          "secondary": { "$type": "color", "$value": "{primitive.color.neutral.ink-600}", "$description": "Most body text." },
          "tertiary":  { "$type": "color", "$value": "{primitive.color.neutral.ink-500}", "$description": "Placeholders / 'Optional'. Avoid elsewhere." },
          "link":      { "$type": "color", "$value": "{primitive.color.core.forest-green}" }
        },
        "interactive": {
          "primary":   { "$type": "color", "$value": "{primitive.color.core.forest-green}" },
          "accent":    { "$type": "color", "$value": "{primitive.color.core.bright-green}", "$description": "Sparingly — e.g. primary button surface." },
          "secondary": { "$type": "color", "$value": "{primitive.color.neutral.ink-400}", "$description": "Borders on inputs/checkboxes. Not on text." },
          "control":   { "$type": "color", "$value": "{primitive.color.core.forest-green}", "$description": "Text/icons on accent surface." },
          "contrast":  { "$type": "color", "$value": "{primitive.color.core.bright-green}", "$description": "Text/icons on interactive-primary surface." }
        },
        "background": {
          "screen":   { "$type": "color", "$value": "{primitive.color.neutral.white}" },
          "elevated": { "$type": "color", "$value": "{primitive.color.neutral.white}" },
          "neutral":  { "$type": "color", "$value": "{primitive.color.alpha.forest-08}" },
          "overlay":  { "$type": "color", "$value": "{primitive.color.alpha.forest-08}" }
        },
        "border": {
          "neutral": { "$type": "color", "$value": "{primitive.color.alpha.ink-12}" },
          "overlay": { "$type": "color", "$value": "{primitive.color.alpha.ink-12}" }
        },
        "sentiment": {
          "negative": { "$type": "color", "$value": "{primitive.color.sentiment.negative}" },
          "positive": { "$type": "color", "$value": "{primitive.color.sentiment.positive}" },
          "warning":  { "$type": "color", "$value": "{primitive.color.sentiment.warning}" }
        },
        "base": {
          "contrast": { "$type": "color", "$value": "{primitive.color.neutral.white}", "$description": "Copy on negative buttons. Flips dark in dark mode." },
          "light":    { "$type": "color", "$value": "{primitive.color.neutral.white}" },
          "dark":     { "$type": "color", "$value": "{primitive.color.neutral.ink-800}" }
        }
      },
      "dark": {
        "$description": "Dark theme. Wise does NOT publish numeric dark-mode hex; these are DERIVED from Wise's documented semantic logic (interactive control/contrast flip; brand greens retained). Replace with official Figma values when available.",
        "$extensions": { "wise.derived": true },
        "content": {
          "primary":   { "$type": "color", "$value": "#FFFFFF", "$extensions": { "wise.derived": true } },
          "secondary": { "$type": "color", "$value": "#B0B3AE", "$extensions": { "wise.derived": true } },
          "tertiary":  { "$type": "color", "$value": "#8A8D87", "$extensions": { "wise.derived": true } },
          "link":      { "$type": "color", "$value": "#9FE870", "$extensions": { "wise.derived": true } }
        },
        "interactive": {
          "primary":   { "$type": "color", "$value": "#9FE870", "$extensions": { "wise.derived": true }, "$description": "Bright green leads interactivity on dark surfaces." },
          "accent":    { "$type": "color", "$value": "#9FE870", "$extensions": { "wise.derived": true } },
          "secondary": { "$type": "color", "$value": "#868685", "$extensions": { "wise.derived": true } },
          "control":   { "$type": "color", "$value": "#163300", "$extensions": { "wise.derived": true }, "$description": "Stays dark on bright-green accent surface." },
          "contrast":  { "$type": "color", "$value": "#9FE870", "$extensions": { "wise.derived": true } }
        },
        "background": {
          "screen":   { "$type": "color", "$value": "#121511", "$extensions": { "wise.derived": true } },
          "elevated": { "$type": "color", "$value": "#1C1F19", "$extensions": { "wise.derived": true } },
          "neutral":  { "$type": "color", "$value": "#9FE8701F", "$extensions": { "wise.derived": true } },
          "overlay":  { "$type": "color", "$value": "#00000052", "$extensions": { "wise.derived": true } }
        },
        "border": {
          "neutral": { "$type": "color", "$value": "#FFFFFF24", "$extensions": { "wise.derived": true } },
          "overlay": { "$type": "color", "$value": "#FFFFFF24", "$extensions": { "wise.derived": true } }
        },
        "sentiment": {
          "negative": { "$type": "color", "$value": "#F06A57", "$extensions": { "wise.derived": true } },
          "positive": { "$type": "color", "$value": "#8FC15B", "$extensions": { "wise.derived": true } },
          "warning":  { "$type": "color", "$value": "#EDC843", "$extensions": { "wise.derived": true } }
        },
        "base": {
          "contrast": { "$type": "color", "$value": "#121511", "$extensions": { "wise.derived": true } },
          "light":    { "$type": "color", "$value": "#FFFFFF", "$extensions": { "wise.derived": true } },
          "dark":     { "$type": "color", "$value": "#121511", "$extensions": { "wise.derived": true } }
        }
      }
    },

    "typography": {
      "$description": "Families and weights are audited. Numeric font sizes / line-heights are NOT published by Wise — values below are DERIVED to a conventional scale and marked derived. Replace with official values when available.",
      "$extensions": { "wise.derived": true },
      "family": {
        "default": { "$type": "fontFamily", "$value": "{primitive.fontFamily.inter}" },
        "display": { "$type": "fontFamily", "$value": "{primitive.fontFamily.wise-sans}" }
      },
      "weight": {
        "body":    { "$type": "fontWeight", "$value": "{primitive.fontWeight.medium}" },
        "emphasis":{ "$type": "fontWeight", "$value": "{primitive.fontWeight.semi-bold}" }
      },
      "style": {
        "display-large":  { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.wise-sans}", "fontWeight": 600, "fontSize": "48px", "lineHeight": "52px", "letterSpacing": "-0.02em" } },
        "display-medium": { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.wise-sans}", "fontWeight": 600, "fontSize": "36px", "lineHeight": "40px", "letterSpacing": "-0.02em" } },
        "title-screen":   { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.inter}", "fontWeight": 600, "fontSize": "28px", "lineHeight": "32px" } },
        "title-section":  { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.inter}", "fontWeight": 600, "fontSize": "22px", "lineHeight": "28px" } },
        "title-group":    { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.inter}", "fontWeight": 600, "fontSize": "18px", "lineHeight": "24px" } },
        "body-large":     { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.inter}", "fontWeight": 500, "fontSize": "16px", "lineHeight": "24px" } },
        "body-default":   { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.inter}", "fontWeight": 500, "fontSize": "14px", "lineHeight": "20px" } },
        "body-small":     { "$type": "typography", "$extensions": { "wise.derived": true }, "$value": { "fontFamily": "{primitive.fontFamily.inter}", "fontWeight": 500, "fontSize": "12px", "lineHeight": "16px" } }
      }
    },

    "spacing": {
      "$description": "Layout/component spacing. Horizontal and vertical roles audited from docs.",
      "horizontal": {
        "between-cards":     { "$type": "dimension", "$value": "{primitive.dimension.size-12}" },
        "between-chips":     { "$type": "dimension", "$value": "{primitive.dimension.size-8}" },
        "screen-mobile":     { "$type": "dimension", "$value": "{primitive.dimension.size-24}" },
        "component-default": { "$type": "dimension", "$value": "{primitive.dimension.size-16}" }
      },
      "vertical": {
        "between-text":        { "$type": "dimension", "$value": "{primitive.dimension.size-8}" },
        "image-bottom":        { "$type": "dimension", "$value": "{primitive.dimension.size-8}" },
        "display-text-bottom": { "$type": "dimension", "$value": "{primitive.dimension.size-16}" },
        "text-to-component":   { "$type": "dimension", "$value": "{primitive.dimension.size-16}" },
        "content-to-button":   { "$type": "dimension", "$value": "{primitive.dimension.size-24}" },
        "between-sections":    { "$type": "dimension", "$value": "{primitive.dimension.size-32}" },
        "between-options":     { "$type": "dimension", "$value": "{primitive.dimension.size-0}" },
        "component-default":   { "$type": "dimension", "$value": "{primitive.dimension.size-16}" }
      }
    },

    "padding": {
      "x-small": { "$type": "dimension", "$value": "{primitive.dimension.size-8}" },
      "small":   { "$type": "dimension", "$value": "{primitive.dimension.size-16}" },
      "medium":  { "$type": "dimension", "$value": "{primitive.dimension.size-24}" },
      "large":   { "$type": "dimension", "$value": "{primitive.dimension.size-32}" }
    },

    "size": {
      "$description": "Component heights.",
      "x-small":  { "$type": "dimension", "$value": "{primitive.dimension.size-24}" },
      "medium":   { "$type": "dimension", "$value": "{primitive.dimension.size-40}" },
      "large":    { "$type": "dimension", "$value": "{primitive.dimension.size-48}" },
      "x-large":  { "$type": "dimension", "$value": "{primitive.dimension.size-56}" },
      "2x-large": { "$type": "dimension", "$value": "{primitive.dimension.size-72}" },
      "icon-default": { "$type": "dimension", "$value": "{primitive.dimension.size-24}" }
    },

    "radius": {
      "$description": "Defaults to desktop scale; switch to primitive.radius.mobile on mobile breakpoints.",
      "small":   { "$type": "dimension", "$value": "{primitive.radius.desktop.small}" },
      "medium":  { "$type": "dimension", "$value": "{primitive.radius.desktop.medium}" },
      "large":   { "$type": "dimension", "$value": "{primitive.radius.desktop.large}" },
      "x-large": { "$type": "dimension", "$value": "{primitive.radius.desktop.x-large}" },
      "2x-large":{ "$type": "dimension", "$value": "{primitive.radius.desktop.2x-large}" }
    },

    "grid": {
      "$description": "Responsive grid. Max width 1440px; beyond, content centres.",
      "$extensions": {
        "wise.breakpoints": {
          "xs":  { "range": "320-479px",   "columns": 6,  "margin": "20px",  "gutter": "12px" },
          "s":   { "range": "480-767px",   "columns": 6,  "margin": "32px",  "gutter": "12px" },
          "m":   { "range": "768-991px",   "columns": 12, "margin": "40px",  "gutter": "16px" },
          "l":   { "range": "992-1199px",  "columns": 12, "margin": "80px",  "gutter": "28px" },
          "xl":  { "range": "1200-1440px", "columns": 12, "margin": "100px", "gutter": "32px" },
          "xxl": { "range": ">1440px",     "columns": 12, "behaviour": "centred" }
        }
      }
    },

    "motion": {
      "$description": "Principles audited (Snappy 60% / Fluid 30% / Intuitive 10%). Wise does NOT publish numeric duration/easing tokens — values below are DERIVED to support web transitions and marked derived.",
      "$extensions": {
        "wise.principles": { "snappy": "fast, satisfying, match-cut", "fluid": "organic, flowing, morphing", "intuitive": "natural pace, physical weight" },
        "wise.flashGuard": "No more than 3 colour changes within 1 second.",
        "wise.derived": true
      },
      "duration": {
        "instant": { "$type": "duration", "$value": "100ms", "$extensions": { "wise.derived": true } },
        "fast":    { "$type": "duration", "$value": "200ms", "$extensions": { "wise.derived": true } },
        "medium":  { "$type": "duration", "$value": "300ms", "$extensions": { "wise.derived": true } },
        "slow":    { "$type": "duration", "$value": "450ms", "$extensions": { "wise.derived": true } }
      },
      "easing": {
        "standard":   { "$type": "cubicBezier", "$value": [0.4, 0.0, 0.2, 1], "$extensions": { "wise.derived": true } },
        "decelerate": { "$type": "cubicBezier", "$value": [0.0, 0.0, 0.2, 1], "$extensions": { "wise.derived": true } },
        "accelerate": { "$type": "cubicBezier", "$value": [0.4, 0.0, 1, 1], "$extensions": { "wise.derived": true } }
      },
      "reducedMotion": { "$type": "duration", "$value": "0ms", "$description": "Honour prefers-reduced-motion." }
    },

    "focus": {
      "$description": "Focus states (web). Shown on keyboard tab, not click. Goes beyond WCAG 2.2 focus appearance.",
      "color":          { "$type": "color", "$value": "{semantic.color.light.interactive.primary}" },
      "color-negative": { "$type": "color", "$value": "{semantic.color.light.sentiment.negative}", "$description": "Used on negative button focus to match surface." },
      "width-default":  { "$type": "dimension", "$value": "2px", "$description": "Buttons, icons, links, other interactive elements." },
      "width-input":    { "$type": "dimension", "$value": "3px", "$description": "Form inputs." },
      "offset":         { "$type": "dimension", "$value": "2px", "$description": "Transparent offset between border and component." },
      "radius":         { "$type": "dimension", "$value": "4px", "$description": "Corner rounding on icon/link focus containers." }
    }
  },

  "component": {
    "$description": "Component-level tokens aliasing semantic tokens. Web state coverage: default, hover, active, focus, disabled.",

    "button": {
      "$extensions": {
        "wise.types": ["default", "negative"],
        "wise.priorities": ["primary", "secondary", "secondary-neutral", "tertiary"],
        "wise.sizes": { "small": "32px", "medium": "40px", "large": "48px" },
        "wise.content": "Sentence case, start with a verb, 1-2 words, no full stop, text wraps (never truncates)."
      },
      "height": {
        "small":  { "$type": "dimension", "$value": "32px" },
        "medium": { "$type": "dimension", "$value": "40px" },
        "large":  { "$type": "dimension", "$value": "48px" }
      },
      "radius":         { "$type": "dimension", "$value": "{semantic.radius.small}" },
      "padding-x":      { "$type": "dimension", "$value": "{semantic.padding.medium}" },
      "focus-width":    { "$type": "dimension", "$value": "{semantic.focus.width-default}" },

      "primary": {
        "$description": "Default/primary: bright-green accent surface, forest-green label (interactive-control).",
        "surface": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.interactive.accent}" },
          "hover":    { "$type": "color", "$value": "#8FD960", "$extensions": { "wise.derived": true } },
          "active":   { "$type": "color", "$value": "#7FCA50", "$extensions": { "wise.derived": true } },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.background.neutral}", "$extensions": { "wise.derived": true } }
        },
        "label": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.interactive.control}" },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.content.tertiary}", "$extensions": { "wise.derived": true } }
        },
        "focus-border": { "$type": "color", "$value": "{semantic.focus.color}" }
      },
      "secondary": {
        "$description": "Secondary: forest-green surface, bright-green label (interactive-contrast). For multiple key actions at equal hierarchy.",
        "surface": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.interactive.primary}" },
          "hover":    { "$type": "color", "$value": "#0F2400", "$extensions": { "wise.derived": true } },
          "active":   { "$type": "color", "$value": "#0A1A00", "$extensions": { "wise.derived": true } },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.background.neutral}", "$extensions": { "wise.derived": true } }
        },
        "label": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.interactive.contrast}" },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.content.tertiary}", "$extensions": { "wise.derived": true } }
        },
        "focus-border": { "$type": "color", "$value": "{semantic.focus.color}" }
      },
      "secondary-neutral": {
        "$description": "Secondary neutral: neutral surface, forest-green label. Convenience/control actions on neutral surfaces.",
        "surface": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.background.neutral}" },
          "hover":    { "$type": "color", "$value": "#1633001F", "$extensions": { "wise.derived": true } },
          "active":   { "$type": "color", "$value": "#16330029", "$extensions": { "wise.derived": true } },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.background.neutral}", "$extensions": { "wise.derived": true } }
        },
        "label": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.interactive.primary}" },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.content.tertiary}", "$extensions": { "wise.derived": true } }
        },
        "focus-border": { "$type": "color", "$value": "{semantic.focus.color}" }
      },
      "tertiary": {
        "$description": "Tertiary: transparent surface, forest-green label. Dismissive actions (cancel, skip, dismiss).",
        "surface": {
          "default":  { "$type": "color", "$value": "#00000000" },
          "hover":    { "$type": "color", "$value": "{semantic.color.light.background.neutral}", "$extensions": { "wise.derived": true } },
          "active":   { "$type": "color", "$value": "#16330029", "$extensions": { "wise.derived": true } },
          "disabled": { "$type": "color", "$value": "#00000000" }
        },
        "label": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.interactive.primary}" },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.content.tertiary}", "$extensions": { "wise.derived": true } }
        },
        "focus-border": { "$type": "color", "$value": "{semantic.focus.color}" }
      },
      "negative": {
        "$description": "Negative type: for destructive confirmations. Focus border uses sentiment-negative.",
        "surface": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.sentiment.negative}" },
          "hover":    { "$type": "color", "$value": "#8C1A0B", "$extensions": { "wise.derived": true } },
          "active":   { "$type": "color", "$value": "#73160A", "$extensions": { "wise.derived": true } },
          "disabled": { "$type": "color", "$value": "{semantic.color.light.background.neutral}", "$extensions": { "wise.derived": true } }
        },
        "label": {
          "default":  { "$type": "color", "$value": "{semantic.color.light.base.contrast}" }
        },
        "focus-border": { "$type": "color", "$value": "{semantic.focus.color-negative}" }
      }
    },

    "input": {
      "$description": "Text input and related form fields.",
      "height":        { "$type": "dimension", "$value": "{semantic.size.large}" },
      "radius":        { "$type": "dimension", "$value": "{semantic.radius.small}" },
      "padding-x":     { "$type": "dimension", "$value": "{semantic.padding.small}" },
      "surface":       { "$type": "color", "$value": "{semantic.color.light.background.screen}" },
      "border-default":{ "$type": "color", "$value": "{semantic.color.light.interactive.secondary}" },
      "border-focus":  { "$type": "color", "$value": "{semantic.focus.color}" },
      "focus-width":   { "$type": "dimension", "$value": "{semantic.focus.width-input}" },
      "text":          { "$type": "color", "$value": "{semantic.color.light.content.primary}" },
      "placeholder":   { "$type": "color", "$value": "{semantic.color.light.content.tertiary}" },
      "border-error":  { "$type": "color", "$value": "{semantic.color.light.sentiment.negative}" }
    },

    "card": {
      "radius":     { "$type": "dimension", "$value": "{semantic.radius.medium}" },
      "padding":    { "$type": "dimension", "$value": "{semantic.padding.small}" },
      "surface":    { "$type": "color", "$value": "{semantic.color.light.background.elevated}" },
      "border":     { "$type": "color", "$value": "{semantic.color.light.border.neutral}" },
      "gap":        { "$type": "dimension", "$value": "{semantic.spacing.horizontal.between-cards}" }
    },

    "alert": {
      "$description": "Variable-height; padding takes priority over fixed height.",
      "padding":          { "$type": "dimension", "$value": "{semantic.padding.medium}" },
      "radius":           { "$type": "dimension", "$value": "{semantic.radius.small}" },
      "surface-neutral":  { "$type": "color", "$value": "{semantic.color.light.background.neutral}" },
      "surface-positive": { "$type": "color", "$value": "{semantic.color.light.sentiment.positive}" },
      "surface-negative": { "$type": "color", "$value": "{semantic.color.light.sentiment.negative}" },
      "surface-warning":  { "$type": "color", "$value": "{semantic.color.light.sentiment.warning}" },
      "icon-size":        { "$type": "dimension", "$value": "{primitive.dimension.size-48}" }
    },

    "chip": {
      "height":  { "$type": "dimension", "$value": "{semantic.size.x-small}" },
      "radius":  { "$type": "dimension", "$value": "{semantic.radius.small}" },
      "gap":     { "$type": "dimension", "$value": "{semantic.spacing.horizontal.between-chips}" },
      "padding-x": { "$type": "dimension", "$value": "{semantic.padding.small}" }
    },

    "avatar": {
      "$description": "Four context sizes.",
      "input":     { "$type": "dimension", "$value": "{primitive.dimension.size-24}" },
      "secondary": { "$type": "dimension", "$value": "{primitive.dimension.size-40}" },
      "list":      { "$type": "dimension", "$value": "{primitive.dimension.size-56}" },
      "main":      { "$type": "dimension", "$value": "{primitive.dimension.size-72}" }
    }
  }
}
